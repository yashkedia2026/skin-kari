# demo = packaging fixtures, provisional per-mask MRP ₹499, selling prices unset
# Demo MRP applies provisionally to all four masks, pending client confirmation.
# live = Shopify required; configuration/API errors never fall back to demo
STOREFRONT_MODE=demo
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Keep false until final prices, inventory, market, policies and Shopify QA are verified.
# Connecting Shopify alone does not enable checkout. Server-only setting.
SHOPIFY_CHECKOUT_VERIFIED=false
# Set true only after the merchant confirms Shopify compareAtPrice is the actual
# per-mask MRP for every live variant. Independent of checkout verification.
SHOPIFY_MRP_VERIFIED=false
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Set only after approving content, policies, photography and completing live QA.
NEXT_PUBLIC_INDEXING_ENABLED=false

# Only if Shopify checkout uses a custom domain (hostname only).
SHOPIFY_CHECKOUT_DOMAIN=
